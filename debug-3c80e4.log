}, {"index": 107, "text": "Askeri Eğitim Kitabı .."}, {"index": 108, "text": "KANUNĠ, ZĠGANA"}, {"index": 109, "text": "Özellik Kanuni S Kanuni 16 Fatih 13"}, {"index": 110, "text": "Mermi 9 x 19 mm 9 x 19 mm 9 x 17 mm"}, {"index": 111, "text": "Etkili Menzil 50 m 50 m 40 m"}, {"index": 112, "text": "ÇalıĢma Sistemi Basit Geri Tepmeli, Basit Geri Tepmeli, Yarı Otomatik"}, {"index": 113, "text": "Yarı Otomatik Yarı Otomatik"}, {"index": 114, "text": "ġarjör 15 15 12"}, {"index": 115, "text": "Emniyet Sistemi Emniyet Mandalı Emniyet Mandalı Emniyet Mandalı"}, {"index": 116, "text": "Ġğne Emniyet Bloğu, Ġğne Emniyet Bloğu, Ġğne Emniyet Bloğu,"}, {"index": 117, "text": "Horoz Emniyeti Horoz Emniyeti Horoz Emniyeti"}, {"index": 118, "text": "NiĢangah Düzeni Sabit Kara Arpacık, Sabit Kara Arpacık, Sabit Kara Arpacık,"}, {"index": 119, "text": "Yarıklı U Gez, Beyaz Yarıklı U Gez, Beyaz Yarıklı U Gez, Beyaz"}, {"index": 120, "text": "Nokta Nokta Nokta"}, {"index": 121, "text": "Tetik Kuvveti 2000 g 2000 g 2000 g"}, {"index": 122, "text": "Ağırlık 866 g 858 g 683 g"}, {"index": 123, "text": "Uzunluk 191 mm 192 mm 172 mm"}, {"index": 124, "text": "Namlu Uzunluğu 110 mm 110 mm 100 mm"}, {"index": 125, "text": "NiĢan Hattı 143 mm 144 mm 123 mm"}, {"index": 126, "text": "Sıcaklık Limiti -35 / +60 -35 / +60 -35 / +60"}, {"index": 127, "text": "Namlu Helisi Sağ Yönlü 6 Sağ Yönlü 6 Sağ Yönlü 6"}, {"index": 128, "text": "Helis 250 mm 250 mm 240 mm"}, {"index": 129, "text": "Namlu Ömrü 25.000 25.000 25.000"}, {"index": 130, "text": "Özellik Zigana C45 Zigana F Zigana T"}, {"index": 131, "text": "Mermi 45 ACP 9 x 19 mm 9 x 19 mm"}, {"index": 132, "text": "Etkili Menzil 75 m 75 m 100 m"}, {"index": 133, "text": "ÇalıĢma Sistemi Basit Geri Tepmeli, Basit Geri Tepmeli, Basit Geri Tepmeli,"}, {"index": 134, "text": "Yarı Otomatik Yarı Otomatik Yarı Otomatik"}, {"index": 135, "text": "ġarjör 9 15+1 15"}, {"index": 136, "text": "Emniyet Sistemi Emniyet Mandalı Emniyet Mandalı Emniyet Mandal